# REPLACE_ME values only — never copy a real key/URL into this file or any .env.
MINI_POOL_ACTIVITY_DATA_FILE=./data/mini-pool-activity.json
MINI_POSITION_DATA_FILE=./data/mini-position.json
MINI_CURATION_DATA_FILE=./data/mini-curation.json

MINI_POOL_ACTIVITY_EVENTS_FILE=./data/events-pool-activity.jsonl
MINI_POSITION_EVENTS_FILE=./data/events-position.jsonl

MINI_READ_API_PORT=4001
MINI_POOL_CURATION_PORT=4002
MINI_POSITION_SERVICE_PORT=4003
MINI_API_GATEWAY_PORT=4000

# mini-api-gateway downstream targets (local dev defaults; REPLACE_ME in any real deploy)
MINI_READ_API_URL=http://localhost:4001
MINI_POOL_CURATION_URL=http://localhost:4002
MINI_POSITION_SERVICE_URL=http://localhost:4003

# mini-site (NEXT_PUBLIC_* end up in the browser bundle: public values only)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_CHAIN_RPC_URL=http://localhost:8545
NEXT_PUBLIC_POSITION_NFT_ADDRESS=REPLACE_ME

# mock chain RPC used only for local geth/anvil/hardhat runs, never a real endpoint
# (geth --dev in infra/local-chain = 1337; anvil = 31337)
MINI_CHAIN_RPC_URL=http://localhost:8545
MINI_CHAIN_ID=1337
# printed by `npm run deploy -w packages/mini-contracts-mock`
MINI_POSITION_NFT_ADDRESS=REPLACE_ME
# Signer for deploy/mint: leave unset locally (the node's unlocked dev account
# signs via eth_sendTransaction). Never put a key in this file.
